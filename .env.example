# =====================================================================
#  Call-senter AI-demo — konfigurasjon (.env.example)
# =====================================================================
#  KJERNEPOENG: Samme kode kjører lokalt eller på Azure. Bytt DEPLOY_TARGET.
#
#  Kopier denne fila til `.env` og fyll inn det du trenger for valgt vei:
#      cp .env.example .env
#
#  Formatet er ren KEY=verdi + #-kommentarer (laster med `set -a; . ./.env`).
#  Ingen ekte hemmeligheter her — alle nøkkel-felt står tomme.
# =====================================================================


# =====================================================================
#  1) HOVEDBRYTER — flytter HELE systemet med én variabel
# =====================================================================
# local  -> mock-providere (offline, ingen nøkler/nett kreves)   [DEFAULT]
# azure  -> Azure AI Speech + Azure OpenAI (EU). Setter automatisk:
#             STT_BACKEND=azure  +  LLM_BACKEND=azure-openai
#           (krever Azure-nøkler i gruppe 6 nedenfor)
DEPLOY_TARGET=local


# =====================================================================
#  2) OVERSTYR PROVIDERE  (valgfritt — for å mikse manuelt)
# =====================================================================
# Settes normalt automatisk av DEPLOY_TARGET. Sett eksplisitt for å
# kjøre f.eks. lokal STT + sky-LLM, eller for å teste én backend om gangen.
# En eksplisitt verdi her VINNER over DEPLOY_TARGET-defaulten.
#
# STT_BACKEND:
#   mock           — ferdig norsk demo-transkript (offline, ingen nøkkel)  [local-default]
#   faster-whisper — lokal Whisper (gruppe 4) — ingen nøkkel, krever pakke
#   nb-whisper     — Nasjonalbibliotekets norske Whisper (gruppe 4) — ingen nøkkel, krever pakke
#   openai         — OpenAI Whisper API (gruppe 5) — betalt, krever nøkkel
#   elevenlabs     — ElevenLabs Scribe (gruppe 5b) — betalt, taler-separasjon, krever nøkkel
#   azure          — Azure AI Speech (gruppe 6) — betalt/EU, krever nøkkel  [azure-default]
# STT_BACKEND=mock
#
# LLM_BACKEND:
#   mock           — deterministisk regelbasert analyse (offline, ingen nøkkel) [local-default]
#   anthropic      — Anthropic Claude (gruppe 5) — betalt, krever nøkkel
#   azure-openai   — Azure OpenAI (gruppe 6) — betalt/EU, krever nøkkel       [azure-default]
# LLM_BACKEND=mock


# =====================================================================
#  3) LOKAL STT — mock  (personvern: 100 % lokalt, ingen nøkkel/nett)
# =====================================================================
# Default i local-modus. Returnerer ferdig norsk demo-transkript som
# matcher sample-navnet. Ingen konfig nødvendig.


# =====================================================================
#  4) LOKAL STT — faster-whisper / nb-whisper
#     Personvern: 100 % lokalt (ingen lyd forlater maskinen).
#     Krever PAKKE, men INGEN API-nøkkel.
# =====================================================================
# faster-whisper:  pip install faster-whisper
# Modellstørrelse — tiny | base | small | medium | large-v3
#   (større = mer nøyaktig + tregere/mer minne; kodens default er "small")
FASTER_WHISPER_MODEL=base
# Maskinvare/ytelse for faster-whisper:
# FASTER_WHISPER_DEVICE=cpu          # cpu | cuda
# FASTER_WHISPER_COMPUTE=int8        # int8 | int8_float16 | float16 | float32
#
# nb-whisper (norsk-optimalisert):  pip install transformers torch
# NB_WHISPER_MODEL=NbAiLab/nb-whisper-small   # ...-tiny | ...-base | ...-small | ...-medium | ...-large


# =====================================================================
#  5) SKY-PROVIDERE (betalt, sky-uavhengig) — personvern: data til US
# =====================================================================
# --- OpenAI Whisper API  (STT_BACKEND=openai) ---
# Krever: pip install openai  +  nøkkel under. Lyd sendes til OpenAI (US).
OPENAI_API_KEY=
# Modell — whisper-1 (stabil) | gpt-4o-transcribe (nyere/bedre)
OPENAI_STT_MODEL=whisper-1
#
# --- Anthropic Claude  (LLM_BACKEND=anthropic) ---
# Krever: pip install anthropic  +  nøkkel under. Tekst sendes til Anthropic (US).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8


# =====================================================================
#  5b) ELEVENLABS  (betalt) — proff STT + realistiske stemmer
#      Personvern: lyd/tekst sendes til ElevenLabs (utenfor EU). Vurder for
#      ekte kundedata; helt OK for demo og syntetiske samtaler.
# =====================================================================
# Brukes til TO ting (samme nøkkel):
#   1) STT  — Scribe-modellen (STT_BACKEND=elevenlabs). Innebygd taler-
#             separasjon (agent/kunde), ingen GPU, bare et API-kall. httpx holder.
#   2) TTS  — realistiske norske stemmer for demo-lyd:
#             .venv/bin/python scripts/gen_elevenlabs_audio.py --all
ELEVENLABS_API_KEY=
# STT-modell (default scribe_v1):
# ELEVENLABS_STT_MODEL=scribe_v1
# TTS — modell + stemme-id-er (se tilgjengelige med: scripts/gen_elevenlabs_audio.py --list-voices)
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# ELEVENLABS_VOICE_AGENT=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_VOICE_KUNDE=EXAVITQu4vr4xnSDxMaL


# =====================================================================
#  6) AZURE (EU)  — personvern: data holdes i EU-region (Sweden Central)
#     Aktiveres samlet av DEPLOY_TARGET=azure.
# =====================================================================
# --- Azure AI Speech  (STT_BACKEND=azure) ---
# Krever: pip install azure-cognitiveservices-speech  +  nøkkel under.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_SPEECH_LANGUAGE=nb-NO
#
# --- Azure OpenAI  (LLM_BACKEND=azure-openai) — bruk EU-region (Sweden Central) ---
# Krever: pip install openai  +  endpoint/nøkkel/deployment under.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
