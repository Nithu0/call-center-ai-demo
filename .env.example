# =====================================================================
#  Call-senter AI-demo — konfigurasjon
# =====================================================================
#  KJERNEPOENG: Samme kode kjører lokalt eller på Azure. Bytt DEPLOY_TARGET.
#
#  De TO env-variablene som flytter hele systemet lokalt -> Azure:
#      DEPLOY_TARGET=azure
#  (DEPLOY_TARGET=azure setter automatisk STT_BACKEND=azure + LLM_BACKEND=azure-openai)
# =====================================================================

# local  -> mock-providere (offline, ingen nøkler/nett kreves) [DEFAULT]
# azure  -> Azure AI Speech + Azure OpenAI (krever nøkler under)
DEPLOY_TARGET=local

# --- Valgfri overstyring av enkeltprovidere ---
# Settes normalt automatisk av DEPLOY_TARGET. Kun for å mikse manuelt.
# STT_BACKEND=mock          # mock | faster-whisper | nb-whisper | azure
# LLM_BACKEND=mock          # mock | anthropic | azure-openai

# ---------------------------------------------------------------------
#  AZURE AI SPEECH  (STT_BACKEND=azure)
# ---------------------------------------------------------------------
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=swedencentral
# AZURE_SPEECH_LANGUAGE=nb-NO

# ---------------------------------------------------------------------
#  AZURE OPENAI  (LLM_BACKEND=azure-openai) — bruk EU-region (Sweden Central)
# ---------------------------------------------------------------------
# AZURE_OPENAI_ENDPOINT=https://<din-resurs>.openai.azure.com
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ---------------------------------------------------------------------
#  ANTHROPIC  (LLM_BACKEND=anthropic) — sky-uavhengig LLM
# ---------------------------------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
